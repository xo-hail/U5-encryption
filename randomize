# function that generates random lists for 24 letters of the alphabet()
    # call index alphabet function

def random_list(alphabet_list):
    letter_list = []
    number_list = []

    while len(letter_list) < len(alphabet_list):
        repeated_numbers = []

        # Main randomization
        number = random.randint(0, 25)

        # Anti-dupe system
        if number not in number_list:
            number_list.append(number)
        else:
            continue

        
        letter_list.append(alphabet_list[number])

    return letter_list

